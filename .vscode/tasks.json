{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cmake build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "Orbital"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "cmake configure",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}